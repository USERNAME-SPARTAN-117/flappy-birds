; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FlappyBirds"
run/main_scene="uid://ive8cmi7cioy"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="uid://fsq2a72re2u"

[autoload]

GameManager="*uid://balv21ctgaq5x"
AudioManager="*uid://kougscyn20h8"

[display]

window/size/viewport_width=144
window/size/viewport_height=256
window/size/mode=2
window/stretch/mode="canvas_items"

[gui]

